{% extends 'base.html.twig' %}

{% block title %}{{ offre.titre }} – AlloStage{% endblock %}

{% block body %}

<main class="py-5 bg-light">
    <section class="container">

        <a href="{{ url_for('liste-offres') }}" class="btn btn-outline-primary rounded-pill px-5"> &larr; Retour aux offres </a>

        <div class="card shadow-sm">

            <div class="card-header bg-primary text-white">
                <h1 class="h4 mb-0">{{ offre.titre }}</h1>
                <p class="mb-0">{{ offre.entreprise ? offre.entreprise.nom : 'N/A' }} · {{ offre.localisation }}</p>
            </div>

                <div class="card-body">
                    <p><strong>Entreprise :</strong> {{ offre.entreprise ? offre.entreprise.nom : 'N/A' }}</p>
                    <p><strong>Localisation :</strong> {{ offre.localisation }}</p>
                    <p><strong>Rémunération :</strong> {{ offre.remuneration ? offre.remuneration ~ ' €/mois' : 'Non rémunéré' }}</p>
                    <p><strong>Durée :</strong> {{ offre.dureeSemaines ? offre.dureeSemaines ~ ' semaines' : 'N/A' }}</p>
                    

                    <hr>

                    <h2 class="h5">Description de l’offre</h2>
                    <p>{{ offre.description }}</p>

                    <div class="mt-4 d-flex gap-3">
                    {% if user_role == 'etudiant' and not candidature %}
                        <a href="{{ url_for('postuler', { id: offre.id }) }}" class="btn btn-primary">Postuler</a>
                    {% elseif user_role == 'etudiant' and candidature %}
                        <span class="badge bg-success">Vous avez déjà postulé à cette offre</span>
                    {% endif %}
                    
                </div>
            {% if candidature %}
                <hr>
                    <h2 class="h5">Ma candidature</h2>
                        <p>
                            <strong>Statut :</strong>
                            {% set badge = candidature.statut == 'Acceptée' ? 'success' : (candidature.statut == 'Refusée' ? 'danger' : 'warning text-dark') %}
                            <span class="badge bg-{{ badge }}">{{ candidature.statut }}</span>
                        </p>
                        <p><strong>Lettre de motivation :</strong></p>
                        <p>{{ candidature.motivation }}</p>
                {% if candidature.cvPath %}
                {% set cvFileName = candidature.cvPath|split('/')|last %}
                    <p><strong>CV envoyé :</strong> {{ cvFileName }}</p>
                    <a href="{{ candidature.cvPath }}" class="btn btn-outline-secondary btn-sm" download="{{ cvFileName }}">
                    Télécharger le CV
                    </a>
                {% else %}
                    <p class="text-muted">CV non disponible.</p>
                {% endif %}
            {% endif %}
            </div>
        </div>
    </section>
</main>

{% endblock %}