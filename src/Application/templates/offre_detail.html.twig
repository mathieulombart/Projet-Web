{% extends 'base.html.twig' %}

{% block title %}{{ offre.titre }} – AlloStage{% endblock %}

{% block body %}

<main class="py-5 bg-light">
    <section class="container">

        <a href="{{ url_for('liste-offres') }}" class="btn btn-outline-primary rounded-pill px-5"> &larr; Retour aux offres </a>

        <div class="card shadow-sm">

            <div class="card-header bg-primary text-white">
                <h1 class="h4 mb-0">{{ offre.titre }}</h1>
                <p class="mb-0">{{ offre.entreprise ? offre.entreprise.nom : 'N/A' }} · {{ offre.localisation }}</p>
            </div>

                <div class="card-body">
                    <p><strong>Entreprise :</strong> {{ offre.entreprise ? offre.entreprise.nom : 'N/A' }}</p>
                    <p><strong>Localisation :</strong> {{ offre.localisation }}</p>
                    <p><strong>Rémunération :</strong> {{ offre.remuneration ? offre.remuneration ~ ' €/mois' : 'Non rémunéré' }}</p>
                    <p><strong>Durée :</strong> {{ offre.dureeSemaines ? offre.dureeSemaines ~ ' semaines' : 'N/A' }}</p>
                    

                    <hr>

                    <h2 class="h5">Description de l’offre</h2>
                    <p>{{ offre.description }}</p>

                    <div class="mt-4 d-flex gap-3">
                    <a href="{{ url_for('postuler', { id: offre.id }) }}" class="btn btn-primary">Postuler</a>
                </div>
            </div>
        </div>

    </section>
</main>

{% endblock %}