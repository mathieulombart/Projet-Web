{% extends 'base.html.twig' %}
{% block body %}
<section class="container py-5">
  <h1 class="text-primary text-center">Ma Wishlist</h1>
  
  <div class="d-flex flex-column gap-3 mt-4">
    {% for item in wishlist %}
      <div class="card p-4 shadow-sm border-0">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <h5 class="fw-bold mb-1">{{ item.offre.titre }}</h5>
            <p class="text-muted mb-0">
                {{ item.offre.localisation }} · {{ item.offre.domaine }}
            </p>
          </div>
          
          <form method="post" action="{{ url_for('wishlist-supprimer', { id: item.id }) }}">
            <button type="submit" class="btn btn-danger rounded-circle"><i class="bi bi-heart-fill"></i></button>
          </form>
        </div>
        <div class="mt-3">
          <a href="{{ url_for('detail-offre', { id: item.offre.id }) }}" class="btn btn-sm btn-outline-primary">Voir l'offre</a>
        </div>
      </div>
    {% else %}
      <p class="text-center text-muted">Votre wishlist est vide.</p>
    {% endfor %}
  </div>
</section>
{% endblock %}