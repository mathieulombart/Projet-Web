<!doctype html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}AlloStage{% endblock %}</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    {% block styles %}{% endblock %}
</head>

<body class="bg-light">

<header class="border-bottom bg-white shadow-sm">
    <nav class="navbar navbar-expand-md bg-white">
        <div class="container">
            <a class="navbar-brand" href="/">
                <img src="/image/Allostage.png" alt="Logo AlloStage" width="180">
            </a>

            <button
                class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navbarAlloStage"
                aria-controls="navbarAlloStage"
                aria-expanded="false"
                aria-label="Afficher le menu"
            >
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarAlloStage">
                <ul class="navbar-nav ms-auto align-items-md-center">
                    <li class="nav-item">
                        <a class="nav-link fw-bold text-primary" href="/entreprises">Entreprises</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-bold text-primary" href="/offres">Offres</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-bold text-primary" href="/profil">Profil</a>
                    </li>
                    <li class="nav-item ms-md-2 mt-2 mt-md-0">
                        {% if user_id %}
                            <a href="/deconnexion" class="btn btn-outline-danger">Déconnexion</a>
                        {% else %}
                            <a href="/connexion" class="btn btn-primary">Connexion</a>
                        {% endif %}
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</header>

{% block body %}{% endblock %}

<footer class="bg-dark text-white text-center py-4 mt-5">
    <div class="container">
        <p class="mb-1">© 2026 AlloStage</p>
        <p class="mb-2">Connecter les étudiants et les entreprises pour construire l'avenir.</p>
        <div class="d-flex justify-content-center gap-3">
            <a href="/mention" class="text-white-50 text-decoration-none">Mentions légales</a>
            <a href="/contact" class="text-white-50 text-decoration-none">Contact</a>
            <a href="/confidentialité" class="text-white-50 text-decoration-none">Confidentialité</a>
        </div>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>