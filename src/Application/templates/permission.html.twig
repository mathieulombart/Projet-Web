{% extends 'base.html.twig' %}

{% block title %}Permission refusée – AlloStage{% endblock %}

{% block body %}
<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            
            {# En-tête de la page #}
            <div class="text-center mb-5">
                <h1 class="display-5 fw-bold text-primary">Vous n'avez pas la permission d'accéder à ce service</h1>
                <p class="text-muted">Veuillez vous connecter à un compte avec des permissions plus élevées si vous souhaitez vraiment utiliser ce service.</p>
                <hr class="w-25 mx-auto border-primary border-2 opacity-75">
            </div>
            <div class="text-center mt-4">
                <a href="/" class="text-decoration-none text-secondary">
                    <i class="bi bi-arrow-left"></i> Retour à l'accueil
                </a>
            </div>

        </div>
    </div>
</div>
{% endblock %}