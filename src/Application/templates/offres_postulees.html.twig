{% extends 'base.html.twig' %}

{% block title %}AlloStage – Offres postulées{% endblock %}

{% block body %}

<section class="container text-center py-5">
  <h1 class="display-6 fw-semibold text-primary">Offres postulées</h1>
  <p class="text-muted">Suivez l'avancement de vos candidatures en temps réel.</p>
</section>

<section class="container pb-5">

  <div class="d-flex align-items-center justify-content-between mb-4">
    <span class="text-muted fw-semibold">{{ candidatures|length }} candidature{{ candidatures|length > 1 ? 's' : '' }} en cours</span>
  </div>

  <div class="d-flex flex-column gap-4">

    {% for c in candidatures %}
    <div class="card border-0 shadow-sm rounded-4 p-4">
      <div class="d-flex align-items-center justify-content-between gap-3 flex-wrap">
        <div>
          <h5 class="fw-bold mb-1">{{ c.offre.titre }}</h5>
          <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="text-muted">{{ c.offre.entreprise ? c.offre.entreprise.nom : 'N/A' }}</span>
            <span class="text-muted">·</span>
            <span class="text-muted">{{ c.offre.localisation ?? 'N/A' }}</span>
            {% if c.offre.dureeSemaines %}
              <span class="badge text-bg-primary rounded-pill">{{ c.offre.dureeSemaines }} semaines</span>
            {% endif %}
          </div>
          <small class="text-muted">Candidaté le {{ c.dateCandidature|date('d/m/Y') }}</small>
        </div>
        {% set badge = c.statut == 'Acceptée' ? 'success' : (c.statut == 'Refusée' ? 'danger' : 'warning text-dark') %}
        <span class="badge bg-{{ badge }} rounded-pill px-3 py-2">{{ c.statut }}</span>
      </div>

      <div class="mt-3 d-flex gap-2">
        <a href="{{ url_for('detail-offre', { id: c.offre.id }) }}" class="btn btn-sm btn-outline-primary rounded-pill">Voir l'offre</a>
        {% if user_role == 'etudiant' %}
          <form method="post" action="{{ url_for('candidature-retirer', { id: c.id }) }}"
                onsubmit="return confirm('Retirer cette candidature ?');">
            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill">Retirer</button>
          </form>
        {% endif %}
      </div>
    </div>
    {% else %}
    <p class="text-muted text-center">Vous n'avez pas encore postulé à une offre.</p>
    {% endfor %}

  </div>

  <div class="text-center mt-5">
    <a href="{{ url_for('profil') }}" class="btn btn-outline-primary rounded-pill px-5"> &larr; Retour au profil </a>
  </div>

</section>

{% endblock %}
