{% extends 'base.html.twig' %}

{% block title %}Postuler à une offre{% endblock %}

{% block body %}
<main class="py-5 bg-light">
  <section class="container">

    <a href="?page=offre" class="btn btn-link mb-3">&larr; Retour aux offres</a>

    <h1 class="mb-4">Postuler à cette offre</h1>

    <form class="was-validated" method="post" enctype="multipart/form-data">
      <div class="mb-3">
        <label for="motivation" class="form-label">Lettre de motivation</label>
        <textarea class="form-control" id="motivation"
                  name="motivation"
                  placeholder="Explique pourquoi tu es le bon candidat"
                  required></textarea>
        <div class="invalid-feedback">
          Veuillez entrer un message dans la zone de texte.
        </div>
      </div>

      <div class="mb-3">
        <label for="cv" class="form-label">Ton CV (PDF)</label>
        <input type="file" class="form-control" id="cv" name="cv"
               aria-label="CV" required>
        <div class="invalid-feedback">
          Merci de joindre ton CV.
        </div>
      </div>

      <div class="mb-3">
        <button class="btn btn-primary" type="submit">
          Envoyer la candidature
        </button>
      </div>
    </form>
  </section>
</main>
{% endblock %}
