{% extends 'base.html.twig' %}

{% block title %}Créer un compte – AlloStage{% endblock %}

{% block body %}

<section class="container py-5 d-flex justify-content-center">
  <div class="card shadow border-0 rounded-4 p-4" style="max-width: 560px; width: 100%;">
    <h2 class="text-center text-primary fw-semibold mb-4">Créer un compte</h2>

    {% if erreurs is defined and erreurs|length > 0 %}
      <div class="alert alert-danger">
        <ul class="mb-0">
          {% for e in erreurs %}<li>{{ e }}</li>{% endfor %}
        </ul>
      </div>
    {% endif %}

    <form action="/inscription" method="post">

      <div class="mb-3">
        <label class="form-label fw-semibold">E-mail</label>
        <input type="email" name="email" class="form-control rounded-pill px-4" placeholder="exemple@mail.com">
      </div>

      <div class="mb-3">
        <label class="form-label fw-semibold">Identifiant</label>
        <input type="text" name="identifiant" class="form-control rounded-pill px-4" placeholder="exemple.Identifiant">
      </div>

      <div class="mb-3">
        <label class="form-label fw-semibold">Nom</label>
        <input type="text" name="nom" class="form-control rounded-pill px-4" placeholder="Dupont">
      </div>

      <div class="mb-3">
        <label class="form-label fw-semibold">Prénom</label>
        <input type="text" name="prenom" class="form-control rounded-pill px-4" placeholder="Marie">
      </div>

      <div class="mb-3">
        <label class="form-label fw-semibold">Type</label>
        <select class="form-select rounded-pill px-4" name="role" id="Type">
          <option value="">-- Choisir un type --</option>
          {% if user_role == 'admin' %}
            <option value="pilote">Pilote</option>
          {% endif %}
          <option value="etudiant">Étudiant</option>
        </select>
      </div>

      <div class="mb-3">
        <label class="form-label fw-semibold">Promotion</label>
        <select class="form-select rounded-pill px-4" name="promo" id="promo">
          <option value="">-- Choisir une promotion --</option>
          <option value="A1">CPI A1</option>
          <option value="A2">CPI A2</option>
          <option value="A3">FISA A3</option>
          <option value="A4">FISA A4</option>
          <option value="A5">FISA A5</option>
        </select>
      </div>

      <div class="mb-3">
        <label class="form-label fw-semibold">Zone</label>
        <select class="form-select rounded-pill px-4" name="campus_id" id="campus_id">
          <option value="">-- Choisir une zone --</option>
          {% for c in campus %}
            <option value="{{ c.id }}">{{ c.ville }}</option>
          {% endfor %}
        </select>
      </div>

      <div class="mb-3">
        <label class="form-label fw-semibold">Mot de passe</label>
        <input type="password" name="password" class="form-control rounded-pill px-4" placeholder="••••••••">
      </div>

      <div class="mb-4">
        <label class="form-label fw-semibold">Confirmer le mot de passe</label>
        <input type="password" name="password-confirm" class="form-control rounded-pill px-4" placeholder="••••••••">
      </div>

      <div class="d-grid">
        <button type="submit"class="btn btn-primary rounded-pill px-4">Créer le compte</button>
      </div>
    </form>   {# ← fermeture du form, avant le </div> de la card #}
  </div>
</section>

{% endblock %}
