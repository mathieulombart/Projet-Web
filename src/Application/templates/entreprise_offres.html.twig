{% extends 'base.html.twig' %}

{% block title %}AlloStage – Offres de {{ entreprise.nom }}{% endblock %}

{% block body %}

<section class="container text-center py-5">
  <h1 class="display-5 fw-semibold text-primary">
    Offres de {{ entreprise.nom }}
  </h1>
  <p class="lead text-muted mt-2">
    {{ entreprise.ville }} · <span class="badge text-bg-primary rounded-pill">{{ entreprise.secteur }}</span>
  </p>
</section>

<section class="container pb-5">

        
        <a href="{{ url_for('liste-entreprises') }}" class="text-primary text-decoration-underline">
               ← Retour aux entreprises </a> 
        
             
  <div class="row g-4">
    {% for offre in offres %}
    <div class="col-12 col-md-6 col-lg-4">
      <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="bg-primary" style="height:72px"></div>
        <div class="p-4 pt-2">
          <h5 class="fw-bold mb-1">{{ offre.titre }}</h5>
          <p class="text-muted small mb-2">
            <span class="badge text-bg-primary rounded-pill">{{ offre.type }}</span>
            {% if offre.localisation %}· {{ offre.localisation }}{% endif %}
          </p>
          <p class="text-muted small mb-3">{{ offre.description }}</p>
          <div class="d-flex flex-column gap-1 small text-muted">
            {% if offre.remuneration %}
              <span>{{ offre.remuneration }}€ / mois</span>
            {% endif %}
            {% if offre.dureeSemaines %}
              <span>{{ offre.dureeSemaines }} semaines</span>
            {% endif %}
            {% if offre.dateDebut %}
              <span>Début : {{ offre.dateDebut|date('d/m/Y') }}</span>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
    {% else %}
    <p class="text-muted">Aucune offre disponible pour cette entreprise.</p>
    {% endfor %}
  </div>

</section>

{% endblock %}