<section class="container py-5 text-center">
  <h2 class="mb-4 text-primary">Notre objectif ?</h2>
  <p class="mb-4">
    L'objectif principal d'Allostage est de mettre en relation les professionnels du monde entier pour les rendre plus performants et productifs.
  </p>
  <ul class="list-group list-group-flush">
    <li class="list-group-item">Connecter les talents entre étudiants et employeurs.</li>
    <li class="list-group-item">Démocratiser l'accès aux opportunités.</li>
    <li class="list-group-item">Valoriser les compétences des candidats.</li>
    <li class="list-group-item">Stimuler l'engagement entre jeunes et entreprises.</li>
  </ul>
</section>

<!-- Carrousel Statistiques -->
<section class="container py-5">
  <h2 class="text-center mb-4 text-primary">Statistiques</h2>

  <div id="carouselStats" class="carousel slide" data-bs-ride="carousel" data-bs-interval="5000">
    <div class="carousel-indicators">
      <button type="button" data-bs-target="#carouselStats" data-bs-slide-to="0" class="active"></button>
      <button type="button" data-bs-target="#carouselStats" data-bs-slide-to="1"></button>
      <button type="button" data-bs-target="#carouselStats" data-bs-slide-to="2"></button>
      <button type="button" data-bs-target="#carouselStats" data-bs-slide-to="3"></button>
    </div>

    <div class="carousel-inner">

      <div class="carousel-item active">
        <div class="d-flex justify-content-center py-5">
          <div class="card border-0 shadow rounded-4 text-center p-5" style="min-width:350px;">
            <h3 class="text-primary display-1 fw-bold">{{ totalOffres }}</h3>
            <p class="text-muted fs-5 mt-2">Offres disponibles</p>
          </div>
        </div>
      </div>

      <div class="carousel-item">
        <div class="d-flex justify-content-center py-5">
          <div class="card border-0 shadow rounded-4 text-center p-5" style="min-width:350px;">
            <h3 class="text-primary display-1 fw-bold">{{ moyenneCandidatures }}</h3>
            <p class="text-muted fs-5 mt-2">Candidatures en moyenne par offre</p>
          </div>
        </div>
      </div>

      <div class="carousel-item">
        <div class="d-flex justify-content-center py-5">
          <div class="card border-0 shadow rounded-4 p-5" style="min-width:400px;">
            <h4 class="text-primary text-center mb-4">Répartition par durée</h4>
            <div class="d-flex justify-content-around text-center">
              <div>
                <span class="display-5 fw-bold text-primary">{{ repartitionDuree.courte }}</span>
                <p class="text-muted mt-1">&lt; 4 sem.</p>
              </div>
              <div>
                <span class="display-5 fw-bold text-primary">{{ repartitionDuree.moyenne }}</span>
                <p class="text-muted mt-1">4–8 sem.</p>
              </div>
              <div>
                <span class="display-5 fw-bold text-primary">{{ repartitionDuree.longue }}</span>
                <p class="text-muted mt-1">&gt; 8 sem.</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="carousel-item">
        <div class="d-flex justify-content-center py-5">
          <div class="card border-0 shadow rounded-4 p-5" style="min-width:400px;">
            <h4 class="text-primary text-center mb-4">Top Wishlist</h4>
            {% if topWishlist|length > 0 %}
              <ol class="list-group list-group-numbered list-group-flush">
                {% for item in topWishlist %}
                  <li class="list-group-item d-flex justify-content-between align-items-center border-0">
                    {{ item.titre }}
                    <span class="badge bg-primary rounded-pill">{{ item.nb }}</span>
                  </li>
                {% endfor %}
              </ol>
            {% else %}
              <p class="text-muted text-center">Aucune donnée pour le moment</p>
            {% endif %}
          </div>
        </div>
      </div>

    </div>

    <button class="carousel-control-prev" type="button" data-bs-target="#carouselStats" data-bs-slide="prev">
      <span class="carousel-control-prev-icon bg-primary rounded-circle p-3"></span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#carouselStats" data-bs-slide="next">
      <span class="carousel-control-next-icon bg-primary rounded-circle p-3"></span>
    </button>
  </div>
</section>

<!-- Carrousel Offres récentes -->
<section class="container py-5">
  <h2 class="text-center mb-5 text-primary">Offres récentes</h2>

  {% if offresRecentes|length > 0 %}
  <div id="carouselOffres" class="carousel slide" data-bs-ride="carousel" data-bs-interval="5000">

    <div class="carousel-indicators">
      {% for offre in offresRecentes %}
        <button type="button" data-bs-target="#carouselOffres"
                data-bs-slide-to="{{ loop.index0 }}"
                {% if loop.first %}class="active"{% endif %}></button>
      {% endfor %}
    </div>

    <div class="carousel-inner">
      {% for offre in offresRecentes %}
        <div class="carousel-item {% if loop.first %}active{% endif %}">
          <div class="d-flex justify-content-center py-3">

            <div class="card shadow border-0 rounded-4 overflow-hidden" style="max-width:500px; width:100%;">

              <!-- En-tête colorée comme offre_detail -->
              <div class="card-header bg-primary text-white py-3 px-4">
                <h5 class="mb-1 fw-bold">{{ offre.titre }}</h5>
                <p class="mb-0 small opacity-75">
                  {{ offre.entreprise_nom ?? 'N/A' }} · {{ offre.localisation ?? 'N/A' }}
                </p>
              </div>

              <div class="card-body px-4 py-3">
                <ul class="list-unstyled mb-3">
                  <li class="mb-2">
                    <strong>Entreprise :</strong>
                    {{ offre.entreprise_nom ?? 'N/A' }}
                  </li>
                  <li class="mb-2">
                    <strong>Localisation :</strong>
                    {{ offre.localisation ?? 'N/A' }}
                  </li>
                  <li class="mb-2">
                    <strong>Rémunération :</strong>
                    {% if offre.remuneration %}
                      {{ offre.remuneration }} €/mois
                    {% else %}
                      Non rémunéré
                    {% endif %}
                  </li>
                  <li class="mb-2">
                    <strong>Durée :</strong>
                    {% if offre.duree_semaines %}
                      {{ offre.duree_semaines }} semaines
                    {% else %}
                      N/A
                    {% endif %}
                  </li>
                  <li class="mb-2">
                    <strong>Compétences :</strong>
                    {{ offre.competences ?? 'N/A' }}
                  </li>
                </ul>

                <hr>

                <h6 class="fw-semibold mb-2">Description de l'offre</h6>
                <p class="text-muted small mb-3">
                  {{ offre.description ? offre.description|slice(0, 150) ~ (offre.description|length > 150 ? '…' : '') : 'Aucune description disponible.' }}
                </p>

                <a href="{{ url_for('detail-offre', { id: offre.id }) }}" class="btn btn-outline-primary btn-sm rounded-pill px-4">
                  Voir l'offre complète →
                </a>
              </div>

            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    <button class="carousel-control-prev" type="button" data-bs-target="#carouselOffres" data-bs-slide="prev">
      <span class="carousel-control-prev-icon bg-primary rounded-circle p-3"></span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#carouselOffres" data-bs-slide="next">
      <span class="carousel-control-next-icon bg-primary rounded-circle p-3"></span>
    </button>
  </div>
  {% else %}
    <p class="text-center text-muted">Aucune offre disponible pour le moment.</p>
  {% endif %}
</section>

<!-- Carrousel Entreprises récentes -->
<section class="container py-5">
  <h2 class="text-center mb-5 text-primary">Entreprises récentes</h2>

  {% if entreprisesRecentes|length > 0 %}
  <div id="carouselEntreprises" class="carousel slide" data-bs-ride="carousel" data-bs-interval="5000">

    <div class="carousel-indicators">
      {% for entreprise in entreprisesRecentes %}
        <button type="button" data-bs-target="#carouselEntreprises"
                data-bs-slide-to="{{ loop.index0 }}"
                {% if loop.first %}class="active"{% endif %}></button>
      {% endfor %}
    </div>

    <div class="carousel-inner">
      {% for entreprise in entreprisesRecentes %}
        <div class="carousel-item {% if loop.first %}active{% endif %}">
          <div class="d-flex justify-content-center py-3">
            <div class="card shadow border-0 rounded-4 overflow-hidden" style="max-width:500px; width:100%;">

              <div class="card-header bg-primary text-white py-3 px-4">
                <h5 class="mb-0 fw-bold">{{ entreprise.nom }}</h5>
                {% if entreprise.secteur %}
                  <p class="mb-0 small opacity-75">{{ entreprise.secteur }}</p>
                {% endif %}
              </div>

              <div class="card-body px-4 py-3">
                <ul class="list-unstyled mb-3">
                  <li class="mb-2">
                    <strong>Secteur :</strong> {{ entreprise.secteur ?? 'N/A' }}
                  </li>
                  <li class="mb-2">
                    <strong>Ville :</strong> {{ entreprise.ville ?? 'N/A' }}
                  </li>
                </ul>
                {% if entreprise.description %}
                  <hr>
                  <h6 class="fw-semibold mb-2">À propos</h6>
                  <p class="text-muted small">
                    {{ entreprise.description|slice(0, 150) }}{% if entreprise.description|length > 150 %}…{% endif %}
                  </p>
                {% endif %}
              </div>

            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    <button class="carousel-control-prev" type="button" data-bs-target="#carouselEntreprises" data-bs-slide="prev">
      <span class="carousel-control-prev-icon bg-primary rounded-circle p-3"></span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#carouselEntreprises" data-bs-slide="next">
      <span class="carousel-control-next-icon bg-primary rounded-circle p-3"></span>
    </button>
  </div>
  {% else %}
    <p class="text-center text-muted">Aucune entreprise disponible pour le moment.</p>
  {% endif %}
</section>

<hr class="container">

<section class="container py-5">

  <div class="row align-items-center mb-5">
    <div class="col-md-6">
      <h2>
      <p>Notre équipe sur votre projet</h2>Chef de projet technique, il pilote les sprints Agile, gère les dépôts Git et coordonne les déploiements CI/CD pour garantir des livraisons fluides et sans régression</p>
    </div>
    <div class="col-md-6">
      <img src="/image/mathieu.jpg" class="img-fluid rounded" style="max-height: 220px; width: auto; object-fit: cover;">
    </div>
  </div>

  <div class="row align-items-center bg-white rounded shadow-sm p-4 mb-5">
    <div class="col-md-6">
      <img src="/image/JB.png" class="img-fluid rounded" style="max-height: 220px; width: auto; object-fit: cover;">
    </div>
    <div class="col-md-6">
      <h2>L'expertise visuelle</h2>
      <p>Expert en intégration web, il transforme chaque maquette Figma en interfaces HTML/CSS pixel-perfect, en veillant à l'accessibilité et à la compatibilité sur tous les navigateurs.</p>
    </div>
  </div>

  <div class="row align-items-center mb-5">
    <div class="col-md-6">
      <h2>La force du Backend</h2>
      <p>spécialiste des bases de données et des API REST, il conçoit des architectures backend solides avec MySQL, et sécurise chaque point d'entrée contre les failles OWASP.</p>
    </div>
    <div class="col-md-6">
      <img src="/image/raph.jpg" class="img-fluid rounded" style="max-height: 220px; width: auto; object-fit: cover;">
    </div>
  </div>

  <div class="row align-items-center bg-white rounded shadow-sm p-4">
    <div class="col-md-6">
      <img src="/image/dorian.jpg" class="img-fluid rounded" style="max-height: 220px; width: auto; object-fit: cover;">
    </div>
    <div class="col-md-6">
      <h2>Coordination et stratégie</h2>
      <p>spécialisé dans le développement web full-stack, 
      il maîtrise aussi bien le frontend que le backend avec PHP Doctrine pour construire des applications modernes et performantes.</p>
    </div>
  </div>

</section>

{% endblock %}

