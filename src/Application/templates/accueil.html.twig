{% extends 'base.html.twig' %}

{% block title %}AlloStage{% endblock %}

{% block body %}

<section class="container text-center py-5">
  <h1 class="display-5 fw-semibold text-primary">
    On connecte les meilleurs employeurs avec une jeunesse curieuse et engagée.
  </h1>
  <p class="lead mt-4">
    Que vous fassiez vos premiers pas dans le monde professionnel ou que vous cherchiez à renforcer vos équipes, Allostage est votre tremplin vers la réussite !
  </p>
</section>

<section class="container mb-5">
  <div class="d-flex flex-column flex-md-row gap-3 align-items-center mb-3">
    <input type="text" class="form-control rounded-pill px-4"
           placeholder="Rechercher une entreprise, un secteur…">
    <a href="#" class="btn btn-primary rounded-pill px-4">Rechercher</a>
  </div>
</section>



<section class="container py-5 text-center">
  <h2 class="mb-4 text-primary">Notre objectif ?</h2>
  <p class="mb-4">
    L'objectif principal d'Allostage est de mettre en relation les professionnels du monde entier pour les rendre plus performants et productifs.
  </p>
  <ul class="list-group list-group-flush">
    <li class="list-group-item">Connecter les talents entre étudiants et employeurs.</li>
    <li class="list-group-item">Démocratiser l'accès aux opportunités.</li>
    <li class="list-group-item">Valoriser les compétences des candidats.</li>
    <li class="list-group-item">Stimuler l'engagement entre jeunes et entreprises.</li>
  </ul>
</section>

<!-- Carrousel Statistiques -->
<section class="container py-5">
  <h2 class="text-center mb-4 text-primary">Statistiques</h2>

  <div id="carouselStats" class="carousel slide" data-bs-ride="carousel" data-bs-interval="4000">

    <div class="carousel-indicators">
      <button type="button" data-bs-target="#carouselStats" data-bs-slide-to="0" class="active"></button>
      <button type="button" data-bs-target="#carouselStats" data-bs-slide-to="1"></button>
      <button type="button" data-bs-target="#carouselStats" data-bs-slide-to="2"></button>
      <button type="button" data-bs-target="#carouselStats" data-bs-slide-to="3"></button>
    </div>

    <div class="carousel-inner">

      <!-- Slide 1 : Total offres -->
      <div class="carousel-item active">
        <div class="d-flex justify-content-center py-5">
          <div class="card border-0 shadow rounded-4 text-center p-5" style="min-width:350px;">
            <h3 class="text-primary display-1 fw-bold">{{ totalOffres }}</h3>
            <p class="text-muted fs-5 mt-2">Offres disponibles</p>
          </div>
        </div>
      </div>

      <!-- Slide 2 : Moyenne candidatures -->
      <div class="carousel-item">
        <div class="d-flex justify-content-center py-5">
          <div class="card border-0 shadow rounded-4 text-center p-5" style="min-width:350px;">
            <h3 class="text-primary display-1 fw-bold">{{ moyenneCandidatures }}</h3>
            <p class="text-muted fs-5 mt-2">Candidatures en moyenne par offre</p>
          </div>
        </div>
      </div>

      <!-- Slide 3 : Répartition par durée -->
      <div class="carousel-item">
        <div class="d-flex justify-content-center py-5">
          <div class="card border-0 shadow rounded-4 p-5" style="min-width:400px;">
            <h4 class="text-primary text-center mb-4">Répartition par durée</h4>
            <div class="d-flex justify-content-around text-center">
              <div>
                <span class="display-5 fw-bold text-primary">{{ repartitionDuree.courte }}</span>
                <p class="text-muted mt-1">&lt; 4 sem.</p>
              </div>
              <div>
                <span class="display-5 fw-bold text-primary">{{ repartitionDuree.moyenne }}</span>
                <p class="text-muted mt-1">4–8 sem.</p>
              </div>
              <div>
                <span class="display-5 fw-bold text-primary">{{ repartitionDuree.longue }}</span>
                <p class="text-muted mt-1">&gt; 8 sem.</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Slide 4 : Top wishlist -->
      <div class="carousel-item">
        <div class="d-flex justify-content-center py-5">
          <div class="card border-0 shadow rounded-4 p-5" style="min-width:400px;">
            <h4 class="text-primary text-center mb-4">Top Wishlist</h4>
            {% if topWishlist|length > 0 %}
              <ol class="list-group list-group-numbered list-group-flush">
                {% for item in topWishlist %}
                  <li class="list-group-item d-flex justify-content-between align-items-center border-0">
                    {{ item.titre }}
                    <span class="badge bg-primary rounded-pill">{{ item.nb }}</span>
                  </li>
                {% endfor %}
              </ol>
            {% else %}
              <p class="text-muted text-center">Aucune donnée pour le moment</p>
            {% endif %}
          </div>
        </div>
      </div>

    </div>

    <button class="carousel-control-prev" type="button" data-bs-target="#carouselStats" data-bs-slide="prev">
      <span class="carousel-control-prev-icon bg-primary rounded-circle p-3"></span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#carouselStats" data-bs-slide="next">
      <span class="carousel-control-next-icon bg-primary rounded-circle p-3"></span>
    </button>
  </div>
</section>

<section class="container py-5">
  <h2 class="text-center mb-5 text-primary">Offres récentes</h2>
  <div class="row g-4">
    <div class="col-md-4">
      <div class="card h-100 shadow border-0 rounded-4">
        <img src="/image/offre.jpg" class="card-img-top rounded-top-4" alt="Offre">
        <div class="card-body text-center">
          <h5 class="card-title">Offre spéciale 1</h5>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card h-100 shadow border-0 rounded-4">
        <img src="/image/offre.jpg" class="card-img-top rounded-top-4" alt="Offre">
        <div class="card-body text-center">
          <h5 class="card-title">Offre spéciale 2</h5>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card h-100 shadow border-0 rounded-4">
        <img src="/image/offre.jpg" class="card-img-top rounded-top-4" alt="Offre">
        <div class="card-body text-center">
          <h5 class="card-title">Offre spéciale 3</h5>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="container py-5">
  <h2 class="text-center mb-5 text-primary">Entreprises récentes</h2>
  <div class="row g-4">
    <div class="col-md-4">
      <div class="card shadow border-0 rounded-4 text-center">
        <img src="/image/entreprise.jpg" class="card-img-top rounded-top-4" alt="Entreprise">
        <div class="card-body">
          <h5>Entreprise récente 1</h5>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card shadow border-0 rounded-4 text-center">
        <img src="/image/entreprise.jpg" class="card-img-top rounded-top-4" alt="Entreprise">
        <div class="card-body">
          <h5>Entreprise récente 2</h5>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card shadow border-0 rounded-4 text-center">
        <img src="/image/entreprise.jpg" class="card-img-top rounded-top-4" alt="Entreprise">
        <div class="card-body">
          <h5>Entreprise récente 3</h5>
        </div>
      </div>
    </div>
  </div>
</section>

<hr class="container">

<section class="container py-5">

  <div class="row align-items-center mb-5">
    <div class="col-md-6">
      <h2>Notre équipe sur votre projet</h2>
      <p>Je vous présente Mehefuz, ingénieur informatique spécialisé dans le développement web.</p>
    </div>
    <div class="col-md-6">
      <img src="/image/personne.jpg" class="img-fluid rounded">
    </div>
  </div>

  <div class="row align-items-center bg-white rounded shadow-sm p-4 mb-5">
    <div class="col-md-6">
      <img src="/image/personne.jpg" class="img-fluid rounded">
    </div>
    <div class="col-md-6">
      <h2>L'expertise visuelle</h2>
      <p>Sarah est notre designer UX/UI qui rend chaque interaction fluide.</p>
    </div>
  </div>

  <div class="row align-items-center mb-5">
    <div class="col-md-6">
      <h2>La force du Backend</h2>
      <p>Lucas assure la sécurité et la gestion des bases de données.</p>
    </div>
    <div class="col-md-6">
      <img src="/image/personne.jpg" class="img-fluid rounded">
    </div>
  </div>

  <div class="row align-items-center bg-white rounded shadow-sm p-4">
    <div class="col-md-6">
      <img src="/image/personne.jpg" class="img-fluid rounded">
    </div>
    <div class="col-md-6">
      <h2>Coordination et stratégie</h2>
      <p>Emma coordonne toute l'équipe pour garantir la qualité du projet.</p>
    </div>
  </div>

</section>

{% endblock %}
