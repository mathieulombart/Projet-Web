{% extends 'base.html.twig' %}

{% block title %}AlloStage – Entreprises{% endblock %}

{% block body %}

<section class="container text-center py-5">
  <h1 class="display-5 fw-semibold text-primary">
    Nos entreprises partenaires
  </h1>
  <p class="lead text-muted mt-2">
    Découvrez les entreprises qui recrutent des stagiaires et alternants.
  </p>
</section>

<section class="container mb-5">
  <div class="d-flex flex-column flex-md-row gap-3 align-items-center mb-3">
    <input
      type="text"
      class="form-control rounded-pill px-4"
      placeholder="Rechercher une entreprise, un secteur…"
    />
    <a href="#" class="btn btn-primary rounded-pill px-4">Rechercher</a>
  </div>

  <div class="d-flex flex-wrap gap-2">
    {% for filtre in filtres %}
      <button class="btn {{ loop.first ? 'btn-primary' : 'btn-outline-secondary' }} rounded-pill px-3">
        {{ filtre }}
      </button>
    {% endfor %}
  </div>
</section>

<section class="container pb-5">

  <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
      <h2 class="h5 mb-0">Entreprises récentes</h2>
      <a href="{{ url_for('ajout-entreprise') }}" class="btn btn-light btn-sm">+ Ajouter</a>
    </div>

    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
          <thead class="table-light">
            <tr>
              <th>Nom</th>
              <th>Secteur</th>
              <th>Ville</th>
              <th>Statut</th>
              <th>Description</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {% for entreprise in entreprises %}
            <tr>
              <td class="fw-semibold">{{ entreprise.nom }}</td>
              <td><span class="badge text-bg-primary rounded-pill">{{ entreprise.secteur }}</span></td>
              <td>{{ entreprise.ville ?? '—' }}</td>
              <td><span class="badge bg-secondary rounded-pill">{{ entreprise.statut }}</span></td>
              <td class="text-muted small">{{ entreprise.description }}</td>
              <td>
                <div class="d-flex gap-2">
                  <a href="/entreprise/{{ entreprise.id }}/offres" class="btn btn-outline-primary btn-sm">Voir les offres</a>
                  <a href="{{ url_for('modifier-entreprise', { id: entreprise.id }) }}" class="btn btn-outline-secondary btn-sm">Modifier</a>
                  <form method="post"
                        action="{{ url_for('supprimer-entreprise', { id: entreprise.id }) }}"
                        class="d-inline"
                        onsubmit="return confirm('Supprimer définitivement cette entreprise ?');">
                    <button type="submit" class="btn btn-danger btn-sm">Supprimer</button>
                  </form>
                </div>
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </div>

<div class="d-flex justify-content-center mt-5">
  <nav>
    <ul class="pagination">

      <li class="page-item {{ pageCourante == 1 ? 'disabled' : '' }}">
        <a class="page-link" href="/entreprises/{{ pageCourante - 1 }}">Précédent</a>
      </li>

      {% for i in 1..totalPages %}
        <li class="page-item {{ i == pageCourante ? 'active' : '' }}">
          <a class="page-link" href="/entreprises/{{ i }}">{{ i }}</a>
        </li>
      {% endfor %}

      <li class="page-item {{ pageCourante == totalPages ? 'disabled' : '' }}">
        <a class="page-link" href="/entreprises/{{ pageCourante + 1 }}">Suivant</a>
      </li>

    </ul>
  </nav>
</div>

</section>
{% endblock %}
