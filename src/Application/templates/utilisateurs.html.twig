{% extends 'base.html.twig' %}

{% block title %}AlloStage – {% if user_role == 'admin' %}Utilisateurs{% else %}Etudiants{% endif %}{% endblock %}

{% block body %}

<form method="get" action="/utilisateurs" class="d-flex mb-4" role="search">
  <input
    class="form-control me-2"
    type="search"
    name="q"
    placeholder="Rechercher un utilisateur"
    value="{{ search|default('') }}"
  >
  <button class="btn btn-outline-primary" type="submit">Rechercher</button>
</form>

<section class="container pb-5">

  <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-header bg-primary text-white d-flex align-items-center gap-2">
      <h2 class="h5 mb-0 me-auto">Utilisateurs</h2>
      {% if user_role in ['admin', 'pilote'] %}
        <a href="{{ url_for('inscription') }}" class="btn btn-light btn-sm">+ Ajouter</a>
      {% endif %}
    </div>

    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
          <thead class="table-light">
            <tr>
              <th>Nom</th>
              <th>Prénom</th>
              <th>Campus</th>
              <th>Email</th>
              <th>Identifiant</th>
              <th>Promotion / Rôle</th>
              {% if user_role == 'admin' %}
                <th>Pilote</th>
              {% endif %}
              {% if user_role in ['admin', 'pilote'] %}
                <th>Actions</th>
              {% endif %}
            </tr>
          </thead>
          <tbody>
            {% for utilisateur in utilisateurs %}
            <tr>
              <td class="fw-semibold">{{ utilisateur.nom }}</td>
              <td>{{ utilisateur.prenom ?? '—' }}</td>
              
              {# Fusion : On vérifie si campus est un objet (ville) ou une chaîne #}
              <td>{{ utilisateur.campus.ville is defined ? utilisateur.campus.ville : (utilisateur.campus ?? '—') }}</td>
              
              <td>{{ utilisateur.email ?? '—' }}</td>
              <td>{{ utilisateur.identifiant ?? '—' }}</td>

              {# Fusion Logique : Affiche le rôle pour les staffs, la promo pour les autres #}
              <td>
                {% if utilisateur.role in ['admin', 'pilote'] %}
                  <span class="badge bg-info text-dark">{{ utilisateur.role }}</span>
                {% else %}
                  {{ utilisateur.promotion ?? '—' }}
                {% endif %}
              </td>

              {% if user_role == 'admin' %}
                <td>{{ utilisateur.pilote ? utilisateur.pilote.nom ~ ' ' ~ utilisateur.pilote.prenom : '—' }}</td>
              {% endif %}

              {% if user_role in ['admin', 'pilote'] %}
              <td>
                <div class="d-flex gap-2">

                  <a href="{{ url_for('modifier') }}" class="btn btn-outline-primary btn-sm">+ Modifier</a>

                  <form method="post" action="{{ url_for('supprimer') }}" class="d-inline"
                        onsubmit="return confirm('Supprimer définitivement cet utilisateur ?');">
                    <input type="hidden" name="nom" value="{{ utilisateur.nom }}">
                    <input type="hidden" name="prenom" value="{{ utilisateur.prenom }}">
                    <input type="hidden" name="email" value="{{ utilisateur.email }}">
                    <input type="hidden" name="identifiant" value="{{ utilisateur.identifiant }}">
                    <button type="submit" class="btn btn-outline-danger btn-sm">- Supprimer</button>
                  </form>
                  {% if user_role == 'pilote' %}
                    <a href="{{ url_for('candidatures-etudiant', { id: utilisateur.id }) }}" 
                      class="btn btn-outline-secondary btn-sm">Candidatures</a>
                  {% endif %}
                </div>
              </td>
              {% endif %}
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  {# Pagination #}
  <div class="d-flex justify-content-center mt-5">
    <nav>
      <ul class="pagination">
        <li class="page-item {{ pageCourante == 1 ? 'disabled' : '' }}">
          <a class="page-link" href="/utilisateurs/{{ pageCourante - 1 }}">Précédent</a>
        </li>
        {% for i in 1..totalPages %}
          <li class="page-item {{ i == pageCourante ? 'active' : '' }}">
            <a class="page-link" href="/utilisateurs/{{ i }}">{{ i }}</a>
          </li>
        {% endfor %}
        <li class="page-item {{ pageCourante == totalPages ? 'disabled' : '' }}">
          <a class="page-link" href="/utilisateurs/{{ pageCourante + 1 }}">Suivant</a>
        </li>
      </ul>
    </nav>
  </div>

</section>
{% endblock %}