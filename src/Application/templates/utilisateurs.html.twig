{% extends 'base.html.twig' %}

{% block title %}AlloStage – {% if user_role == 'admin' %}Utilisateurs{% else %}Etudiants{% endif %}{% endblock %}

{% block body %}

<form method="get" action="/utilisateurs" class="d-flex mb-4" role="search">
  <input
    class="form-control me-2"
    type="search"
    name="q"
    placeholder="Rechercher un utilisateur"
    value="{{ search|default('') }}"
  >
  <button class="btn btn-outline-primary" type="submit">Rechercher</button>
</form>



</section>

<section class="container pb-5">

  <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
      <h2 class="h5 mb-0">Utilisateurs</h2>
      {% if user_role in ['admin', 'pilote'] %}
        <a href="{{ url_for('inscription') }}" class="btn btn-light btn-sm">+ Ajouter</a>
      {% endif %}
    </div>

    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
          <thead class="table-light">
            <tr>
              <th>Nom</th>
              <th>Prénom</th>
              <th>Campus</th>
              <th>email</th>
              <th>Identifiant</th>
              <th>Promotion</th>
              {% if user_role == 'admin' %}
                <th>Pilote</th>
              {% endif %}
            </tr>
          </thead>
          <tbody>
            {% for utilisateur in utilisateurs %}
            <tr>
              <td class="fw-semibold">{{ utilisateur.nom }}</td>
              <td>{{ utilisateur.prenom ?? '—' }}</td>
              <td>{{ utilisateur.campus ? utilisateur.campus.ville : '—' }}</td>
              <td>{{ utilisateur.identifiant ?? '—' }}</td>
              <td>{{ utilisateur.email ?? '—' }}</td>
              {% if user_role == 'admin' %}
                <td>{{ utilisateur.pilote ?? '—' }}</td>
              {% endif %}
              <td>
                <div class="d-flex gap-2">
                  {#<a href="{{ url_for('modifier-entreprise', { id: utilisateur.id }) }}" class="btn btn-outline-secondary btn-sm">Modifier</a>
                  <form method="post"
                        action="{{ url_for('supprimer-entreprise', { id: utilisateur.id }) }}"
                        class="d-inline"
                        onsubmit="return confirm('Supprimer définitivement cette entreprise ?');">
                    <button type="submit" class="btn btn-danger btn-sm">Supprimer</button>
                  </form>#}
                </div>
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </div>

<div class="d-flex justify-content-center mt-5">
  <nav>
    <ul class="pagination">

      <li class="page-item {{ pageCourante == 1 ? 'disabled' : '' }}">
        <a class="page-link" href="/utilisateurs/{{ pageCourante - 1 }}">Précédent</a>
      </li>

      {% for i in 1..totalPages %}
        <li class="page-item {{ i == pageCourante ? 'active' : '' }}">
          <a class="page-link" href="/utilisateurs/{{ i }}">{{ i }}</a>
        </li>
      {% endfor %}

      <li class="page-item {{ pageCourante == totalPages ? 'disabled' : '' }}">
        <a class="page-link" href="/utilisateurs/{{ pageCourante + 1 }}">Suivant</a>
      </li>

    </ul>
  </nav>
</div>

</section>
{% endblock %}